[core]
	filemode = false
	fscache = true
	symlinks = true
[credential]
	helper = manager
[credential "https://dev.azure.com"]
	useHttpPath = true
[diff "astextplain"]
	textconv = astextplain
[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
	smudge = git-lfs smudge -- %f
[http]
	sslBackend = openssl
