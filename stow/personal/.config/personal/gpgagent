#!/usr/bin/env zsh

# I would prefer ssh signing cause termux has broken gpg.
return

! whence gpg >/dev/null && echo 'gpg not found' && return
[[ -z $(gpg --list-secret-keys 2>/dev/null) ]] && echo 'no keys in gpg' && return

# Will capture the command itself.
#gpg_state=$(ps -ef | grep "^[[:space:]]*`id -un`" | grep "gpg-agent")

gpg_state=$(ps -ef | grep 'gpg-agent')
gpg_state=$(echo $gpg_state | grep "^[[:space:]]*$USERNAME" | grep 'gpg-agent ')
if [[ $gpg_state ]]; then
    # gpg-agent is running under the current user
    if echo $gpg_state | grep -q -- --enable-ssh-support; then
        # gpg-agent supports ssh
        # By the way, looking back to MSYS2 and ssh-agent,
        # user and admin ssh and gpg sockets should be separated.
        # Anyway, I don't use gpg right now.
        if [[ -S ~/.gnupg/S.gpg-agent.ssh ]]; then
            export SSH_AUTH_SOCK=~/.gnupg/S.gpg-agent.ssh
        else
            echo 'Could not find ssh auth sock provided by gpg-agent'
        fi
    else
        # gpg-agent does not support ssh
        echo 'gpg-agent is running but without ssh support. Restarting with ssh support...'
        gpg-connect-agent killagent /bye
        eval "$(gpg-agent --enable-ssh-support --daemon)"
    fi
else
    # gpg-agent is not running
    eval "$(gpg-agent --enable-ssh-support --daemon)"
fi

# To kill gpg-agent, use
# gpgconf --kill gpg-agent
# or
# gpg-connect-agent killagent /bye
# or to reload
# gpg-connect-agent reloadagent /bye
#
# Get help for /bye
# gpg-connect-agent help /bye
