#
#	# Run ssh-keygen detached from terminal.
#	setsid -w ssh-keygen -y -f $1 >/dev/null 2>&1
#)

sshadd() {
    sshagent
    local fingerprint key
    [[ -z $SSH_AUTH_SOCK ]] && echo 'SSH_AUTH_SOCK is not defined' && return 1
    ssh-add -l >/dev/null 2>&1
    [[ $? = 2 ]] && echo 'ssh-agent was unable to connect to SSH_AUTH_SOCK' && return 1
    #~/.ssh/id_rsa ~/.ssh/sign_rsa
    for key in ~/.ssh/*.pub(DN); do
        key=${key%.pub}
        [[ -s $key ]] || continue
        fingerprint=$(ssh-keygen -l -f $key)
        ssh-add -l | grep -qF $fingerprint || ssh-add $key
    done
}

# man zshexpn: D=GLOB_DOTS, N=NULL_GLOB, Y1=short-circuit on first match
[[ $(echo ~/.ssh/*.pub(DNY1)) ]] || return 0
#find ~/.ssh/ -maxdepth 1 -name '*.pub' >/dev/null 2>&1 || return 0

sshagent
