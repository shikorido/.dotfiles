#!/usr/bin/env zsh

[[ $USERNAME != hadoop ]] && return

if [[ ! -d ~/spark-3.5.3 ]]; then
	echo "$HOME/spark-3.5.3 is not a directory or does not exist."
	return
fi

export SPARK_HOME=~/spark-3.5.3
export PYSPARK_PYTHON=python3

addToPathFront $SPARK_HOME/bin
addToPathFront $SPARK_HOME/sbin

if [[ :$PYTHONPATH: != *:$SPARK_HOME/python:* ]]; then
	export PYTHONPATH=$SPARK_HOME/python:$PYTHONPATH
fi

